# ============================================================================
# telemetry-gateway image — Node WebSocket server that serves the leaderboard
# its display-ready delta feed. In this repo it runs the reference/mock
# implementation (tools/telemetry_server.js). The production gateway (Rust/Go,
# reading VictoriaMetrics + additive HDR) is a drop-in replacement that speaks
# the same wire shape; the frontend does not change.
# ============================================================================
FROM node:20-alpine
WORKDIR /app
# The gateway runtime needs only `ws` (telemetry_server.js uses http/fs/path +
# ws). express/puppeteer are dev/test-only (devDependencies) and must NOT land
# here — puppeteer's Chromium download breaks on alpine/musl and bloats the
# image. --omit=dev + the skip-download guard keep this lean.
ENV PUPPETEER_SKIP_DOWNLOAD=1
COPY package.json package-lock.json /app/
RUN npm install --omit=dev --no-audit --no-fund
COPY . /app
EXPOSE 8080
ENTRYPOINT []
