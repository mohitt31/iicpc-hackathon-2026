# ============================================================================
# bot-engine build image — compiles bot, reference_engine, null_responder, etc.
# Multi-stage: build with full toolchain, run on a slim base.
#
# Build context: repo root (..). The Dockerfile expects bot-engine/ as a
# subdirectory of the context so it can build via cmake.
# ============================================================================

# ---- build stage --------------------------------------------------------
FROM ubuntu:24.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake g++ git ca-certificates zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch 0.11.8 https://github.com/HdrHistogram/HdrHistogram_c.git /tmp/hdr_c \
    && cd /tmp/hdr_c && mkdir build && cd build \
    && cmake .. -DHDR_HISTOGRAM_BUILD_PROGRAMS=OFF -DHDR_HISTOGRAM_BUILD_SHARED=OFF \
    && make -j && make install

WORKDIR /src
# Repo root is the build context (so /src/bot-engine, /src/contracts both exist)
COPY . /src

RUN cd bot-engine && rm -rf build && mkdir -p build && cd build && cmake .. && make -j"$(nproc)"

# ---- runtime stage ------------------------------------------------------
FROM ubuntu:24.04 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /src/bot-engine/build /app/build
COPY --from=build /src/bot-engine/demo  /app/demo
COPY --from=build /src/bot-engine/test  /app/test

# Containers cannot CPU-pin or SO_BUSY_POLL without extra caps; the bot
# detects this and degrades gracefully (logs a warning, continues). For
# real latency numbers, deploy on bare metal via the K8s path, not here.
ENTRYPOINT []
