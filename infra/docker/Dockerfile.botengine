# ============================================================================
# bot-engine build image — compiles bot, reference_engine, null_responder, etc.
# Multi-stage: build with full toolchain, run on a slim base.
# ============================================================================

# ---- build stage --------------------------------------------------------
FROM ubuntu:24.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake g++ git ca-certificates \
        libhdrhistogram-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# bot-engine sources are the build context (see docker-compose context: ../bot-engine)
COPY . /src

RUN mkdir -p build && cd build && cmake .. && make -j"$(nproc)"

# ---- runtime stage ------------------------------------------------------
FROM ubuntu:24.04 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        libhdrhistogram-dev bash \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /src/build /app/build
COPY --from=build /src/demo  /app/demo
COPY --from=build /src/test  /app/test

# Containers cannot CPU-pin or SO_BUSY_POLL without extra caps; the bot
# detects this and degrades gracefully (logs a warning, continues). For
# real latency numbers, deploy on bare metal via the K8s path, not here.
ENTRYPOINT []
